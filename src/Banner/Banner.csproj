<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.*"/>
    </ItemGroup>

    <PropertyGroup>
        <PackageId>DotNetBanner</PackageId>
        <Version>0.1.0</Version>
        <Description>Generates a colourful FIGlet ASCII-art startup banner at build time.</Description>
        <PackageTags>figlet;banner;ascii-art;source-generator</PackageTags>
    </PropertyGroup>

    <!-- Build the generator first, without referencing its types or flowing it to consumers. -->
    <ItemGroup>
        <ProjectReference Include="..\Banner.Generator\Banner.Generator.csproj"
                          PrivateAssets="all"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup>
        <!-- analyzers/dotnet/cs is the folder convention that makes NuGet pass this to the compiler. -->
        <None Include="..\Banner.Generator\bin\$(Configuration)\netstandard2.0\Banner.Generator.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              Visible="false"/>

        <None Include="buildTransitive\DotNetBanner.props" Pack="true" PackagePath="buildTransitive"/>

        <None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false"/>
    </ItemGroup>

</Project>
