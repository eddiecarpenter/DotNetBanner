<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.*"/>
    </ItemGroup>

    <PropertyGroup>
        <PackageId>Banner</PackageId>
        <Version>0.1.0</Version>
        <Authors>Eddie Carpenter</Authors>
        <Description>Generates a colourful FIGlet ASCII-art startup banner at build time.</Description>
        <PackageTags>figlet;banner;ascii-art;source-generator</PackageTags>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/…</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\Banner.Generator\bin\$(Configuration)\netstandard2.0\Banner.Generator.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              Visible="false"/>
    </ItemGroup>

</Project>
