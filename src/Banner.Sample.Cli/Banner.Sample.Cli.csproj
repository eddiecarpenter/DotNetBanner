<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>

        <BannerText>{red}My {blue}Service\nTesting</BannerText>
        <BannerFont>doom</BannerFont>
        <BannerPoweredBy>true</BannerPoweredBy>
        <BannerAutoPrint>true</BannerAutoPrint>
        <BannerColor>default</BannerColor>
        <BannerAlignment>right</BannerAlignment>
        <BannerLineSpacing>1</BannerLineSpacing>
    </PropertyGroup>

    <!-- The same file the NuGet package ships; consumers get it automatically. -->
    <Import Project="..\Banner\buildTransitive\DotNetBanner.props"/>

    <ItemGroup>
        <ProjectReference Include="..\Banner\Banner.csproj"/>
        <ProjectReference Include="..\Banner.Generator\Banner.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>

    </ItemGroup>
</Project>